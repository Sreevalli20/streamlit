# Environment Variables for ChronosMatch
# Copy this file to .env and modify as needed

# Cloud deployment flag
# Set to "true" when deploying to Render or other cloud platforms
# This allows the app to run with Python 3.12.x instead of requiring 3.14.6
RENDER=false

# Server configuration
PORT=10000
HOST=0.0.0.0

# Target operations per second for the order firehose
TARGET_OPS=50000
